# Smart HRMS Production Environment Configuration
# Copy this to .env.production and update with your actual values

# ─────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://hrms_user:SecurePassword123@localhost:5432/hrms_production
SQLALCHEMY_TRACK_MODIFICATIONS=False

# ─────────────────────────────────────────────────────────
# FLASK CONFIGURATION
# ─────────────────────────────────────────────────────────
FLASK_ENV=production
FLASK_APP=run.py
DEBUG=False
TESTING=False
SECRET_KEY=your-secret-key-here-change-this-in-production

# ─────────────────────────────────────────────────────────
# SERVER CONFIGURATION
# ─────────────────────────────────────────────────────────
# Choose ONE of these based on your setup:
# Local Network: SERVER_NAME=192.168.1.100 or hrms-server.local
# Static IP: SERVER_NAME=your-company-hrms.com
# VPN: SERVER_NAME=hrms.vpn.company.com
SERVER_NAME=hr-management-system.local
PREFERRED_URL_SCHEME=https
MAX_CONTENT_LENGTH=52428800

# ─────────────────────────────────────────────────────────
# SECURITY CONFIGURATION
# ─────────────────────────────────────────────────────────
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=86400
REMEMBER_COOKIE_DURATION=2592000

# ─────────────────────────────────────────────────────────
# EMAIL CONFIGURATION (for password resets)
# ─────────────────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password

# ─────────────────────────────────────────────────────────
# REDIS/CACHE CONFIGURATION (optional but recommended)
# ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TYPE=redis
CACHE_REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────────
# LOGGING & PATHS
# ─────────────────────────────────────────────────────────
LOG_DIR=/var/log/hrms
LOG_LEVEL=INFO
UPLOAD_FOLDER=/var/data/hrms/uploads
BACKUP_DIR=/var/backups/hrms

# ─────────────────────────────────────────────────────────
# PERFORMANCE
# ─────────────────────────────────────────────────────────
WORKERS=4
WORKER_CLASS=sync
WORKER_CONNECTIONS=100
TIMEOUT=60

# ─────────────────────────────────────────────────────────
# CORS (if using mobile app or external frontend)
# ─────────────────────────────────────────────────────────
CORS_ORIGINS=https://your-domain.com,https://your-mobile-app.com
